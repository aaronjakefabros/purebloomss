# Laravel .gitignore

# Environment files
.env
.env.backup
.env.production
.env.local

# Dependencies
/vendor
/node_modules

# Build files
/public/build
/public/hot
/public/storage

# Storage files
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*

# IDE files
/.idea
/.vscode
/.fleet
/.nova

# OS files
.DS_Store
Thumbs.db

# Testing
.phpunit.result.cache
/phpunit.cache

# Auth
/auth.json

# Logs
*.log
npm-debug.log
yarn-error.log

# Misc
Homestead.json
Homestead.yaml
.phpactor.json
zed